.3;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="8" y="3" width="604" height="18" /></mxCell><mxCell id="n1" value="C&lt;sub&gt;e−1&lt;/sub&gt;: anchor&lt;br&gt;generation a&lt;br&gt;input tip q" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14.5;fontColor=#182633;fillColor=#EFF6F0;strokeColor=#507859;strokeWidth=1.3;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="8" y="32" width="186" height="90" /></mxCell><mxCell id="n2" value="C&lt;sub&gt;e&lt;/sub&gt;: HOLD&lt;br&gt;same input tip q&lt;br&gt;new control hash" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14.5;fontColor=#182633;fillColor=#EFF6F0;strokeColor=#507859;strokeWidth=1.3;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="217" y="32" width="186" height="90" /></mxCell><mxCell id="n3" value="C&lt;sub&gt;e+1&lt;/sub&gt;: HOLD&lt;br&gt;same input tip q&lt;br&gt;link finalizes C&lt;sub&gt;e&lt;/sub&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14.5;fontColor=#182633;fillColor=#EFF6F0;strokeColor=#507859;strokeWidth=1.3;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="426" y="32" width="187" height="90" /></mxCell><mxCell id="n4" value="READY successor retrieves the complete inherited state and input data." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=13.5;fontColor=#182633;fillColor=none;strokeColor=none;strokeWidth=1.3;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="8" y="143" width="604" height="18" /></mxCell><mxCell id="n5" value="C&lt;sub&gt;e+2&lt;/sub&gt;: ROTATE&lt;br&gt;pending generation a+1&lt;br&gt;same input tip q" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14.5;fontColor=#182633;fillColor=#EDF4FA;strokeColor=#426A8C;strokeWidth=1.3;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="8" y="196" width="186" height="94" /></mxCell><mxCell id="n6" value="C&lt;sub&gt;e+3&lt;/sub&gt;: CONFIRM&lt;br&gt;same pending state&lt;br&gt;link finalizes ROTATE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14.5;fontColor=#182633;fillColor=#EDF4FA;strokeColor=#426A8C;strokeWidth=1.3;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="217" y="196" width="186" height="94" /></mxCell><mxCell id="n7" value="Finality proof π&lt;sub&gt;R&lt;/sub&gt;&lt;br&gt;authorizes successor;&lt;br&gt;later record consumes it" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14.5;fontColor=#182633;fillColor=#EDF4FA;strokeColor=#426A8C;strokeWidth=1.3;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="426" y="196" width="187" height="94" /></mxCell><mxCell id="n8" value="Pending descendants do not advance data; only finalized ROTATE activates." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=13.5;fontColor=#182633;fillColor=none;strokeColor=none;strokeWidth=1.3;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="8" y="317" width="604" height="18" /></mxCell><mxCell id="n9" value="Preserve A4; cancel unretained A2/A3 tails and fence fresh old-generation output." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#182633;fillColor=none;strokeColor=none;strokeWidth=1.3;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="8" y="345" width="604" height="18" /></mxCell></root></mxGraphModel>